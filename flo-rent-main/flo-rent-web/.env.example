# คัดลอกเป็น .env แล้วเติมค่า (อย่า commit ไฟล์ .env จริง)
# บน Vercel ให้ตั้งค่าเหล่านี้ใน Project → Settings → Environment Variables แทน
# บรรทัดที่ขึ้นต้นด้วย # คือค่าที่ไม่บังคับ — เอาคอมเมนต์ออกเมื่อต้องการตั้งค่า

# --- โหมดการทำงาน ---
# production = ไม่สร้างบัญชีทดลอง/ข้อมูลตัวอย่าง และบังคับให้แอดมินมาจาก env ด้านล่าง
NODE_ENV=production
# พอร์ต/โฮสต์ของเซิร์ฟเวอร์ในเครื่อง (ค่าเริ่มต้น 4173 / 127.0.0.1)
PORT=4173
# HOST=127.0.0.1

# --- แอดมิน (ต้องตั้งทั้งคู่ รหัสผ่านอย่างน้อย 10 ตัวอักษร) ---
# ห้ามใช้ admin@flo-rent.co / demo@flo-rent.co / owner@flo-rent.co — production บล็อกอีเมลทดลอง (403)
FLO_ADMIN_EMAIL=
FLO_ADMIN_PASSWORD=
# FLO_ADMIN_NAME=ผู้ดูแล FLO-RENT

# --- อีเมล OTP: เลือกผู้ให้บริการอย่างน้อยหนึ่งตัว ---
# ถ้าตั้งทั้งสองคีย์ ระบบจะเลือก Resend ก่อน
# RESEND_API_KEY=re_xxx
# BREVO_API_KEY=xkeysib-xxx
# ผู้ส่งต้องเป็นอีเมล/โดเมนที่ยืนยันกับผู้ให้บริการแล้ว
# FLO_MAIL_FROM=FLO-RENT <no-reply@yourdomain.com>
# FLO_MAIL_FROM_NAME=FLO-RENT

# --- ความปลอดภัย/เครือข่าย ---
# เพดานคำขอต่อนาทีต่อ IP (ค่าเริ่มต้น 20)
# FLO_RATE_LIMIT_PER_MIN=20
# โดเมนที่อนุญาตให้เรียก API ที่เขียนข้อมูล (คั่นด้วยจุลภาค)
# FLO_ALLOWED_ORIGINS=https://flo-rent.co,https://www.flo-rent.co

# --- ที่เก็บข้อมูล ---
# โฟลเดอร์เก็บ db.json (ค่าเริ่มต้น server/data)
# FLO_DATA_DIR=/var/lib/flo-rent
# เปิดแคตตาล็อกตั้งต้น 16 รายการ (บน Vercel เปิดอัตโนมัติ) — ใส่ 0 เพื่อปิด
# FLO_SEED_CATALOG=0
# โหมดเดโม: ให้บัญชีใหม่ผ่านการยืนยันตัวตนอัตโนมัติ — ใส่ 0 เพื่อทดสอบเส้นทางรออนุมัติ
# FLO_DEMO_AUTO_VERIFY=0

# --- Redis (ทางเลือก: ใช้เมื่อรันหลาย instance เช่นบน Vercel) ---
# Vercel + Upstash ตั้งสองตัวแรกให้อัตโนมัติเมื่อเชื่อม Storage
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# ทางเลือกแทนสองตัวข้างบน (ชื่อเดียวกับ Upstash)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ชื่อ key ใน Redis (ค่าเริ่มต้น florent:db)
# FLO_DB_KEY=florent:db

# --- การยืนยันตัวตนด้วยบัตรประชาชน ---
# salt สำหรับ hash เลขบัตร (ตั้งเป็นค่าสุ่มใน production)
# FLO_ID_SALT=
# คีย์เข้ารหัสรูปบัตร AES-256-GCM (ตั้งเป็น Secret ใน production)
# FLO_ID_ENCRYPTION_KEY=
# secret สำหรับ HMAC ของรหัส OTP (ถ้าไม่ตั้งจะใช้ FLO_ID_SALT)
# FLO_OTP_SECRET=
